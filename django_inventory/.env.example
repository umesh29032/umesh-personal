# Kapil Enterprises ERP — production environment template (direction C).
# Copy to .env on the VPS, fill values, AND store the filled copy in the
# password manager (it is part of the disaster-recovery pair with the restic
# repo). NEVER commit .env.

# ── Django ────────────────────────────────────────────────────────────────

# Which settings file Django loads. Must stay config.settings.production on
# the server — it enables DEBUG=False and all HTTPS security hardening.
DJANGO_SETTINGS_MODULE=config.settings.production

# Master signing key for sessions, CSRF and password-reset tokens. 50+ random
# chars; app REFUSES TO BOOT without it (fail-fast, intentional).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_with_50_plus_char_secret_key

# Hostnames Django will answer for (comma-separated). Anything else = HTTP 400.
# Must match DOMAIN below. Never use * in production.
ALLOWED_HOSTS=erp.example.com

# Origins trusted for HTTPS form posts behind the Caddy TLS proxy.
# Scheme REQUIRED (https://). Wrong value = every form fails with CSRF 403.
CSRF_TRUSTED_ORIGINS=https://erp.example.com

# Single PostgreSQL connection string (parsed by dj_database_url).
# Host "db" = the compose service name. The password here MUST be byte-identical
# to POSTGRES_PASSWORD below.
DATABASE_URL=postgres://kapil:replace_with_postgres_password@db:5432/kapil

# Shared Redis cache — also stores the auth rate-limiter counters, so the app
# REFUSES TO BOOT without it (fail-fast). Host "redis" = compose service name.
REDIS_URL=redis://redis:6379/0

# V2-3 / ADR-0007: cutover EXECUTED — default False (earnings book ONLY at
# Adda settlement). Setting True is the ROLLBACK LEVER: restores legacy
# allocation-time crediting with all guards intact. See deploy/README.md.
LEDGER_CREDIT_AT_ALLOCATION=False

# ── Email (SMTP) + Google OAuth — same keys local .env already uses ──────

# SMTP server that sends app email (password resets, verification).
EMAIL_HOST=smtp.example.com

# SMTP port; 587 = STARTTLS (encrypted). Keep unless your provider differs.
EMAIL_PORT=587

# The sending mailbox / SMTP username.
EMAIL_HOST_USER=replace_with_smtp_user@example.com

# SMTP credential. For Gmail use an APP PASSWORD, never the real account
# password. Rotate at the provider if ever exposed.
EMAIL_HOST_PASSWORD=replace_with_smtp_app_password

# Google OAuth app ID for "Login with Google" (Google Cloud Console).
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id

# Google OAuth app secret — proves login requests come from YOUR app.
# Secret: rotate in Google Cloud Console if ever exposed.
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret

# ── Infra (compose) ───────────────────────────────────────────────────────

# Hostname Caddy serves + auto-fetches the Let's Encrypt certificate for.
# DNS A record must point at this server BEFORE first start, or TLS fails.
DOMAIN=erp.example.com

# Database name created by the db container on its very first boot.
# Must match the db name inside DATABASE_URL.
POSTGRES_DB=kapil

# Database user created on first boot. Must match the user in DATABASE_URL.
POSTGRES_USER=kapil

# Password for that user, set on FIRST boot of the db container.
# MUST match the password inside DATABASE_URL exactly.
POSTGRES_PASSWORD=replace_with_postgres_password

# ── Backups (restic → Backblaze B2; use s3: URI for Cloudflare R2) ───────

# Where restic stores encrypted off-site backups. Backblaze B2 bucket shown;
# for Cloudflare R2 use an s3: URI (s3:https://example-backup style).
RESTIC_REPOSITORY=b2:kapil-erp-backups:/

# Encrypts every backup. NO reset, NO recovery: losing this = losing ALL
# backups permanently. Must live in the password manager.
RESTIC_PASSWORD=replace_with_restic_encryption_password

# Backblaze B2 application key ID (lets restic reach the bucket).
B2_ACCOUNT_ID=replace_with_b2_key_id

# Backblaze B2 application key — the actual credential. Rotate in the B2
# console if ever exposed (leak = backup bucket readable/deletable).
B2_ACCOUNT_KEY=replace_with_b2_application_key
