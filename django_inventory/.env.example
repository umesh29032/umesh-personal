# Kapil Enterprises ERP — production environment template (direction C).
# Copy to .env on the VPS, fill values, AND store the filled copy in the
# password manager (it is part of the disaster-recovery pair with the restic
# repo). NEVER commit .env.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=                       # 50+ random chars
ALLOWED_HOSTS=erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
DATABASE_URL=postgres://kapil:CHANGE_ME@db:5432/kapil
REDIS_URL=redis://redis:6379/0
# V2-2 / ADR-0007 cutover lever. True (default) = legacy allocation-time
# crediting stays live alongside Adda settlements. False = earnings book ONLY
# at Adda settlement (the target state). Flip to False is the owner's explicit
# cutover act, gated on the real-worker soak — see deploy/README.md Rollback.
LEDGER_CREDIT_AT_ALLOCATION=True

# ── Email (SMTP) + Google OAuth — same keys local .env already uses ──────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Infra (compose) ───────────────────────────────────────────────────────
DOMAIN=erp.example.com
POSTGRES_DB=kapil
POSTGRES_USER=kapil
POSTGRES_PASSWORD=CHANGE_ME       # must match DATABASE_URL

# ── Backups (restic → Backblaze B2; use s3: URI for Cloudflare R2) ───────
RESTIC_REPOSITORY=b2:kapil-erp-backups:/
RESTIC_PASSWORD=                  # encrypts the backups — losing this = losing backups
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
