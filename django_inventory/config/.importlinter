# Import-linter contract — enforces the acyclic app layering established in the
# 2026-06 architecture remediation. Run from this directory (apps are importable
# as top-level packages here):
#
#     pip install import-linter
#     cd config && lint-imports
#
# A lightweight subset (foundation purity) is ALSO enforced in the test suite
# without this dependency — see core/tests.py::FoundationPurityTests.

[importlinter]
root_packages =
    core
    accounts
    inventory
    raw_materials
    production
    tracking
    expense
    storefront

# ── Contract 1: foundation apps depend on nothing higher ─────────────────────
[importlinter:contract:foundation-purity]
name = core + accounts import no domain app (module level)
type = forbidden
source_modules =
    core
    accounts
forbidden_modules =
    raw_materials
    production
    tracking
    expense
    inventory
    storefront
# accounts.services.user_service does a LAZY (function-body) production import for
# the skill→layering retro-tag — intentional, not an import-load cycle.
# accounts/tests.py imports inventory.Role inside setUp to exercise the
# permission-cache against a seeded role — test-only, not a runtime layering edge.
ignore_imports =
    accounts.services.user_service -> production.services
    accounts.tests -> inventory.models

# ── Contract 2: acyclic layering (top imports down, never up) ─────────────────
# P4.2 (2026-06-11): tracking flipped BELOW production (D2). tracking is the
# barcode range/scan/history PRIMITIVE — ID/value-addressed, string-FK'd,
# imports no production. Production owns assembly/export/orchestration and
# writes tracking rows (downward). The old tracking→production ignore block is
# GONE — the relocated code made it unnecessary.
# core (bottom) ← accounts ← raw_materials ← tracking ← production ← apps
[importlinter:contract:acyclic-layers]
name = Acyclic app layering (target)
type = layers
layers =
    storefront : expense : inventory
    production
    tracking
    raw_materials
    accounts
    core
# This contract is REPORT-ONLY in scripts/check.sh — its violation list IS the
# coupling worklist (M4). P4.2 (2026-06-11) cleared the tracking↔production
# cycle: every former tracking RUNTIME edge is gone (code relocated), so the
# old tracking ignore block is deleted. What the worklist still shows:
#   • production → expense (SWA allocation/credit reads) — retires at V2-3
#     (settlement earning line + one-file facade), FUTURE-STAGE-REDESIGN tagged.
#   • raw_materials → production/tracking (roll-assign view + roll_service
#     history logging) — relocation candidates, same pattern as P4.2.
#   • *.tests → higher apps — test fixtures, noise; clean up opportunistically.
ignore_imports =
    accounts.services.user_service -> production.services
    accounts.tests -> inventory.models
