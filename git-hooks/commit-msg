#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# commit-msg — reject a commit message that is not Conventional Commits.
#
# WHY: the format is not bureaucracy. It is what makes a CHANGELOG generatable
# instead of hand-written, drives the SemVer bump (feat→MINOR, fix→PATCH,
# BREAKING CHANGE→MAJOR), and makes `git log --grep` useful years later.
#
# Git calls commit-msg with $1 = path to the file holding the message.
# Exit non-zero → the commit is aborted and the message is preserved.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

MSG_FILE="$1"

# First non-comment, non-empty line = the subject.
SUBJECT="$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -1 || true)"

red()  { printf '\033[31m%s\033[0m\n' "$*"; }
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }

# Merge/revert/fixup commits are generated by git itself — never block them.
case "$SUBJECT" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

# type(optional-scope)!: subject
PATTERN='^(feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert)(\([a-z0-9_,./-]+\))?!?: .+'

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
    red "✖ Commit message is not in Conventional Commits format."
    echo
    bold "  Got:"
    echo "    $SUBJECT"
    echo
    bold "  Expected:"
    echo "    <type>(<scope>): <subject>"
    echo
    bold "  Valid types:"
    echo "    feat fix docs chore refactor test perf build ci style revert"
    echo
    bold "  Examples:"
    echo "    feat(expense): add accountant read tier"
    echo "    fix(production): correct settlement entry_date to IST"
    echo "    docs(git): add chapter on interactive rebase"
    echo "    chore(repo): stop tracking database dumps"
    echo "    feat(api)!: drop the v1 endpoint          # ! = breaking"
    echo
    dim  "  Your message was NOT lost — fix it with:  git commit --edit --file=.git/COMMIT_EDITMSG"
    dim  "  Emergency override:  git commit --no-verify"
    exit 1
fi

# Subject-line length. 72 keeps "git log --oneline" readable in a terminal.
SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt 72 ]; then
    red "✖ Subject line is $SUBJECT_LEN chars (max 72)."
    echo
    echo "    $SUBJECT"
    echo
    dim  "  Move the detail into the body — the body has no length limit."
    # NOTE: single quotes here on purpose. Backticks inside a DOUBLE-quoted bash
    # string are command substitution — an earlier version of this line contained
    # `git log --oneline` as prose and the hook actually RAN it, dumping the whole
    # history into its own error message. Caught by the hook rejecting a real commit.
    dim  '  A long subject truncates in "git log --oneline" and in GitHub'"'"'s UI.'
    exit 1
fi

# Trailing period: pure noise in a subject line, and it costs a char.
case "$SUBJECT" in
    *.) red "✖ Subject line must not end with a period."
        echo "    $SUBJECT"
        exit 1 ;;
esac

exit 0
